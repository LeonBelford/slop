# Kopieren nach .env und mit `set -a; . ./.env; set +a` laden (oder scripts/run.sh benutzen)
LLM_API=http://localhost:11434/v1/chat/completions
LLM_API_KEY=ollama
OLLAMA_API_BASE=http://localhost:11434

# Modelle pro Rolle (Ollama-Namen). CODER_MODEL ist ein Aider-Modellstring (ollama_chat/<name>).
PLANNER_MODEL=qwen2.5-coder-agent
REVIEWER_MODEL=qwen2.5-coder-agent
SUMMARIZER_MODEL=qwen2.5-coder-agent
CODER_MODEL=ollama_chat/qwen2.5-coder-agent
