# Copy to .env and load with `set -a; . ./.env; set +a` (or use scripts/run.sh)
LLM_API=http://localhost:11434/v1/chat/completions
LLM_API_KEY=ollama
OLLAMA_API_BASE=http://localhost:11434

# Models per role (Ollama names). CODER_MODEL is an Aider model string (ollama_chat/<name>).
PLANNER_MODEL=qwen2.5-coder-agent
REVIEWER_MODEL=qwen2.5-coder-agent
SUMMARIZER_MODEL=qwen2.5-coder-agent
CODER_MODEL=ollama_chat/qwen2.5-coder-agent
